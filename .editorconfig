root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2

# Generated by `yarn types:payload`, which emits no trailing newline. Without
# this, saving the file in an editor re-adds one and the CI staleness check
# reports a diff that regenerating cannot fix.
[next-frontend/src/types/payload.ts]
insert_final_newline = false
