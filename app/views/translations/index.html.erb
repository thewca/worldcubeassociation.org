<% provide(:title, 'Translations Status') %>
<div class="container">
  <h1><%= yield(:title) %></h1>
  <table class="table">
    <% @weblate_codes.each do |locale, weblate_code| %>
      <tr>
        <td><%= AvailableLocales::ALL[locale][:name] %> (<%= locale %>)</td>
        <td>
          <a href="<%= TranslationsController::WEBLATE_URL %>/engage/wca/">
            <img src="<%= TranslationsController::WEBLATE_URL %>/widget/wca/-/<%= weblate_code %>/svg-badge.svg" alt="Translation status">
          </a>
        </td>
      </tr>
    <% end %>
  </table>
</div>
